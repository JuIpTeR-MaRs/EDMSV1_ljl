# EDMS Backend Configuration Example
# Copy this file to .env and modify values

# For MySQL (Local):
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/edms_db


SECRET_KEY=dev-change-me
JWT_SECRET_KEY=jwt-dev-change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DeepSeek AI Config
DEEPSEEK_API_KEY=

# Spark AI Config
SPARK_APPID=
SPARK_API_KEY=
SPARK_API_SECRET=

# AI Proxy Config
AI_IGNORE_PROXIES=true
