# ==============================================================================
# EDMS 统一环境配置文件模板 (.env.example)
# ==============================================================================
# 复制此文件为同一目录下的 .env 并根据需要修改配置。
# 所有子模块（后端、前端、Docker 部署）都将从此文件中读取配置。

# ------------------------------------------------------------------------------
# 1. 基础与安全配置 (Core & Security)
# ------------------------------------------------------------------------------
# Flask 应用密钥
SECRET_KEY=edms-secure-development-key-32-chars-long-min

# JWT 身份验证密钥 - 生产环境请务必更改此项！
JWT_SECRET_KEY=jwt-secure-development-key-32-chars-long-min

# CORS 跨域源许可列表 (以英文逗号分隔，同时包含了本地运行和 Docker 运行的主机)
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. 本地手工部署配置 (Local Manual Run)
# ------------------------------------------------------------------------------
# 本地 MySQL 数据库连接地址 (使用本地手动运行 backend_start.bat 时生效)
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/edms_db

# ------------------------------------------------------------------------------
# 3. Docker 部署配置 (Docker Compose)
# ------------------------------------------------------------------------------
# 容器外部映射端口 (通过 Web 访问的 HTTP/HTTPS 端口)
WEB_PORT=80
SSL_PORT=443

# Docker 容器内部 MySQL 的参数配置
MYSQL_ROOT_PASSWORD=edms_root_pass
MYSQL_DATABASE=edms_db
MYSQL_USER=edms_developer
MYSQL_PASSWORD=edms_dev_pass

# Docker 后端所使用的数据库连接地址
DOCKER_DATABASE_URL=mysql+pymysql://edms_developer:edms_dev_pass@db:3306/edms_db

# ------------------------------------------------------------------------------
# 4. AI 模型与服务商配置 (AI & Model Services)
# ------------------------------------------------------------------------------
# DeepSeek 大模型配置
DEEPSEEK_API_KEY=

# 科大讯飞星火大模型 (Spark AI) 配置
SPARK_APPID=
SPARK_API_KEY=
SPARK_API_SECRET=

# 是否忽略 AI 请求的系统代理
AI_IGNORE_PROXIES=true

# Hugging Face 镜像加速端点 (适用于国内环境下载模型)
HF_ENDPOINT=https://hf-mirror.com

# FastEmbed 模型缓存目录
FASTEMBED_CACHE_PATH=fastembed_cache

# ------------------------------------------------------------------------------
# 5. 前端环境变量 (Vite)
# ------------------------------------------------------------------------------
# Vite 接口前缀 (默认通过前端 Nginx/Vite dev proxy 代理至 /api)
# VITE_API_BASE=/api

# 可选：当 API 位于另一台服务器时，指定 Socket.IO 链接地址
# VITE_SOCKET_URL=http://127.0.0.1:5000
